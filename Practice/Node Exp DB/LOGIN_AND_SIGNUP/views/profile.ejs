<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
        <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="min-h-screen bg-gray-100 flex flex-col items-center">
  <div class="w-full max-w-4xl bg-white shadow-lg rounded-2xl overflow-hidden mt-10">
    
    <div class="h-48 w-full bg-gradient-to-r from-blue-500 to-purple-600"></div>

    <div class="relative px-8 pb-8">
      <div class="flex flex-col sm:flex-row items-center sm:items-end -mt-16 sm:space-x-5">
        <div class="relative">
          <img class="h-32 w-32 rounded-full border-4 border-white object-cover shadow-md" src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=200&q=80" alt="User Avatar">
          <span class="absolute bottom-2 right-2 block h-4 w-4 rounded-full bg-green-500 border-2 border-white"></span>
        </div>
        
        <div class="mt-6 sm:mt-0 text-center sm:text-left flex-1">
          <h1 class="text-3xl font-bold text-gray-900">Alex Rivers</h1>
          <p class="text-gray-600 font-medium">Senior Product Designer</p>
        </div>

        <div class="mt-6 flex space-x-3">
          <button class="px-5 py-2 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition">Follow</button>
          <button class="px-5 py-2 border border-gray-300 text-gray-700 rounded-lg font-semibold hover:bg-gray-50 transition">Message</button>
        </div>
      </div>

      <hr class="my-8 border-gray-200">

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="md:col-span-2 space-y-6">
          <section>
            <h2 class="text-xl font-bold text-gray-800 mb-2">About</h2>
            <p class="text-gray-600 leading-relaxed">
              Passionate designer with over 8 years of experience building digital products. Focused on creating user-centric interfaces that are both beautiful and functional. Currently exploring the intersection of AI and UX.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-gray-800 mb-3">Skills</h2>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">UI/UX Design</span>
              <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">Tailwind CSS</span>
              <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">Figma</span>
              <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">React</span>
              <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">Prototyping</span>
            </div>
          </section>
        </div>

        <div class="space-y-6">
          <div class="bg-gray-50 p-6 rounded-xl border border-gray-100">
            <h3 class="font-bold text-gray-800 mb-4">Quick Stats</h3>
            <div class="space-y-3">
              <div class="flex justify-between">
                <span class="text-gray-500">Projects</span>
                <span class="font-bold text-gray-900">124</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-500">Followers</span>
                <span class="font-bold text-gray-900">12.5k</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-500">Following</span>
                <span class="font-bold text-gray-900">482</span>
              </div>
            </div>
          </div>

          <div class="space-y-3">
             <div class="flex items-center text-gray-600">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                San Francisco, CA
             </div>
             <div class="flex items-center text-gray-600">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                rivers.design
             </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>